---
import CustomButton from "../../ui/customButton/CustomButton";
---

<section class="relative min-h-svh container mx-auto bg-theme-white">
  <div
    class="absolute z-10 left-25 top-1/2 -translate-y-1/2 max-w-225 space-y-14 mix-blend-difference"
  >
    <h1 class="text-6xl text-font-white">
      Making green hydrogen affordable through advanced materials
    </h1>
    <p class="text-2xl text-font-white">
      More than ever we need materials technology and innovation to help us
      tackle some of our pressing challenges, such as climate change, for humans
      and the planet.
    </p>
  </div>

  <div
    class="w-225 h-125 bg-theme-blue absolute right-10 top-1/2 -translate-y-1/2"
  >
  </div>

  <CustomButton
    client:load
    text="Partner with us"
    onClick={() => console.log("Click!")}
    className="absolute bottom-5 right-10"
  />
</section>
